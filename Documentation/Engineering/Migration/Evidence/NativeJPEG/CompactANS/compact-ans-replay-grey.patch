+        var prefixHeader = BitWriter(), ansHeader = BitWriter()
+        try prefix.writeHeader(to: &prefixHeader, contexts: 15 * (37 + 458))
+        try ans.writeHeader(to: &ansHeader, contexts: 15 * (37 + 458))
