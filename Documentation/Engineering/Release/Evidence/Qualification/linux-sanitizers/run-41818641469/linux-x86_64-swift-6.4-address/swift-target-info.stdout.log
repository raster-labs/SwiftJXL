{
  "compilerVersion": "Swift version 6.4.2 (swift-6.4.2-RELEASE)",
  "swiftCompilerTag": "swift-6.4.2-RELEASE",
  "target": {
    "triple": "x86_64-unknown-linux-gnu",
    "unversionedTriple": "x86_64-unknown-linux-gnu",
    "moduleTriple": "x86_64-unknown-linux-gnu",
    "platform": "linux",
    "arch": "x86_64",
    "pointerWidthInBits": 64,
    "pointerWidthInBytes": 8,
    "compatibilityLibraries": [ ],
    "openbsdBTCFIEnabled": false,
    "librariesRequireRPath": false
  },
  "paths": {
    "runtimeLibraryPaths": [
      "/usr/lib/swift/linux"
    ],
    "runtimeLibraryImportPaths": [
      "/usr/lib/swift/linux",
      "/usr/lib/swift/linux/x86_64"
    ],
    "runtimeResourcePath": "/usr/lib/swift"
  }
}
